{
  "name": "research-agent",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=${localWorkspaceFolder}/reports,target=/out,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "RESEARCH_REPORTS_DIR": "/out",
    "EXA_API_KEY": "${localEnv:EXA_API_KEY}",
    "TAVILY_API_KEY": "${localEnv:TAVILY_API_KEY}"
  },
  "runArgs": [
    "--init",
    "--cap-add=NET_ADMIN",
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined"
  ],
  "remoteUser": "vscode"
}
