# Copy to .env and fill in real keys. Never commit .env.
EXA_API_KEY=
TAVILY_API_KEY=

# Quota fallback policy. The default first tries a secondary Claude model for
# model-bucket usage limits, then switches to Codex. Organization-wide spend
# limits skip the redundant Claude retry. Set either value empty to disable it.
RESEARCH_LIMIT_FALLBACK_MODEL=claude-opus-4-7
RESEARCH_LIMIT_FALLBACK_PROVIDER=codex

# Optional override. By default the host re-reads ~/.codex/auth.json on every
# call; the file must be owned by the current user and mode 0600.
# CODEX_AUTH_FILE=/home/you/.codex/auth.json
