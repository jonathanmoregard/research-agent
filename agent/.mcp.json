{
  "mcpServers": {
    "exa": {
      "command": "python3",
      "args": ["/workspace/agent/shims/exa_shim.py"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "tavily-remote-mcp": {
      "command": "python3",
      "args": ["/workspace/agent/shims/tavily_shim.py"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "render": {
      "command": "python3",
      "args": ["/workspace/agent/shims/render_shim.py"]
    },
    "trademark": {
      "command": "python3",
      "args": ["/workspace/agent/shims/trademark_shim.py"],
      "env": {
        "EUIPO_CLIENT_ID": "${EUIPO_CLIENT_ID}",
        "EUIPO_CLIENT_SECRET": "${EUIPO_CLIENT_SECRET}"
      }
    },
    "bolagsverket": {
      "command": "python3",
      "args": ["/workspace/agent/shims/bolagsverket_shim.py"]
    },
    "prv": {
      "command": "python3",
      "args": ["/workspace/agent/shims/prv_shim.py"],
      "env": {
        "PRV_CACHE_DIR": "${PRV_CACHE_DIR}"
      }
    }
  }
}
